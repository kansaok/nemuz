# Build output. `go build ./cmd/...` and `go build ./examples/...` drop binaries
# in the working directory, so the binary names are ignored explicitly as well
# as the directories we build into on purpose.
/bin/
/dist/
/nemuz
/plugin-go
/seed

# Litter from running commands with HOME pointed at the workspace. The exec
# tool now uses a scratch directory outside the project, but a mistake here
# costs a repository full of build cache, so it stays ignored.
/.cache/
/.config/
/go/
/.npm/
/.local/

# Test artefacts
*.test
coverage.out

# Local configuration
.env
